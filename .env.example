# Copy to .env. Never commit it.
PUID=1000
PGID=1000

# Music folder on the host, mounted read-only at the SAME path inside Liquidsoap
# as Jellyfin uses (path_map.remote in neighbeats' config), so no translation exists.
MUSIC_PATH=/media/music

# neighbeats' ./run folder (holds neighbeats.sock)
NEIGHBEATS_RUN=../neighbeats/run

# Traefik
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
RADIO_HOST=radio.example.com
# htpasswd -nb user pass   (double every $ as $$ in this file)
RADIO_BASICAUTH=user:$$apr1$$changeme
